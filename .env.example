# --- Supabase Postgres -------------------------------------------------------
# Project URL from Supabase dashboard → Project Settings → Data API.
PROJECT_URL=https://your-project-ref.supabase.co

# Database password (Project Settings → Database). Server-only; never expose it
# to the browser (no NEXT_PUBLIC_ prefix).
DATABASE_PASSWORD=

# Optional: pooler host for your project's region. Supabase's direct host
# (db.<ref>.supabase.co) is IPv6-only, so the pooler is required.
# Find it in Supabase → Connect → Transaction pooler.
SUPABASE_DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com

# Optional: full connection string. When set, it wins over the values above.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# --- Links -------------------------------------------------------------------
# Public origin used in QR codes and attendee links. Leave unset locally to use
# the request origin; set it in production (e.g. https://attendance.example.com).
APP_BASE_URL=


# Optional server-side Google Apps Script web app for attendance sync.
# Keep this URL private; never expose it as NEXT_PUBLIC_*.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional Apps Script GET endpoint returning [{ facultyId, name, email, department }].
GOOGLE_SHEETS_FACULTY_URL=
